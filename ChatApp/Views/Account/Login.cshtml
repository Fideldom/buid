@model ChatApp.DTOs.LoginDto
@{ Layout = null; }
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar - ChatApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-page d-flex align-items-center justify-content-center">
    <div class="card shadow-sm auth-card">
        <div class="card-body p-4">
            <h3 class="mb-4 text-center">Entrar no ChatApp</h3>
            <div asp-validation-summary="All" class="text-danger small"></div>
            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" placeholder="dylande@exemplo.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Palavra-passe</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label class="form-check-label">Manter sessão iniciada</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>
            <p class="text-center mt-3 mb-0">
                Não tem conta? <a asp-controller="Account" asp-action="Register">Criar conta</a>
            </p>
        </div>
    </div>
</body>
</html>
