@model ChatApp.DTOs.RegisterDto
@{ Layout = null; }
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Criar conta - ChatApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-page d-flex align-items-center justify-content-center">
    <div class="card shadow-sm auth-card">
        <div class="card-body p-4">
            <h3 class="mb-4 text-center">Criar conta</h3>
            <div asp-validation-summary="All" class="text-danger small"></div>
            <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data">
                <div class="mb-3 text-center">
                    <label class="form-label d-block">Foto de perfil</label>
                    <input asp-for="Photo" type="file" accept="image/*" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Nome completo</label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Palavra-passe</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirmar palavra-passe</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Criar conta</button>
            </form>
            <p class="text-center mt-3 mb-0">
                Já tem conta? <a asp-controller="Account" asp-action="Login">Entrar</a>
            </p>
        </div>
    </div>
</body>
</html>
