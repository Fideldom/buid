@model ChatApp.DTOs.TwoFactorLoginDto
@{
    ViewData["Title"] = "Autenticação em dois fatores";
    Layout = null;
    var rememberMe = (bool?)ViewData["RememberMe"] ?? false;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Autenticação em dois fatores - ChatApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body{min-height:100vh;display:grid;place-items:center;margin:0;background:#f4f7fb;color:#172033;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;padding:24px}
        .twofa-login{width:min(430px,100%);padding:32px;border:1px solid #e3e8f0;border-radius:22px;background:#fff;box-shadow:0 20px 60px rgba(15,23,42,.09)}
        .icon{width:58px;height:58px;display:grid;place-items:center;margin-bottom:18px;border-radius:18px;background:#eff6ff;color:#2563eb;font-size:25px}
        h1{font-size:24px;font-weight:800;margin:0 0 8px}.lead{font-size:13px;color:#718096;line-height:1.6;margin-bottom:24px}
        label{font-size:12px;font-weight:700;margin-bottom:7px}.code{height:54px;text-align:center;letter-spacing:.3em;font-size:20px;font-weight:800}
        .btn-main{height:48px;width:100%;border:0;border-radius:12px;background:#2563eb;color:#fff;font-weight:750;margin-top:18px}.btn-main:hover{background:#1d4ed8}
        .validation-summary{font-size:12px;color:#b91c1c;margin-bottom:15px}.hint{font-size:11px;color:#8a94a6;margin-top:12px;line-height:1.5}
    </style>
</head>
<body>
    <main class="twofa-login">
        <div class="icon"><i class="bi bi-shield-lock-fill"></i></div>
        <h1>Confirma a tua identidade</h1>
        <p class="lead">Introduz o código de 6 dígitos apresentado pela tua aplicação autenticadora para concluir o início de sessão.</p>

        <form asp-action="TwoFactorLogin" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RememberMe" value="@(rememberMe.ToString().ToLowerInvariant())" />
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <label asp-for="Code">Código de autenticação</label>
            <input asp-for="Code" class="form-control code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" autofocus placeholder="000000" />

            <button type="submit" class="btn-main">
                <i class="bi bi-check2-circle me-1"></i>
                Confirmar e entrar
            </button>

            <p class="hint">Se não tens acesso à aplicação autenticadora, usa um dos códigos de recuperação que guardaste quando ativaste a proteção.</p>
        </form>
    </main>
</body>
</html>
