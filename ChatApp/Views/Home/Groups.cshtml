@{
  ViewData["Title"] = "Grupos"; Layout = "_Layout";
}
<div class="groups-page container-fluid py-4" id="groupsApp">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Grupos</h1>
      <p class="text-muted mb-0">Conversa com várias pessoas num só lugar.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createGroupModal"><i
      class="bi bi-plus-lg me-1"></i>Novo grupo</button>
    </div>
    <div id="groupsList" class="row g-3"></div>
  </div>
  <div class="modal fade" id="createGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Criar grupo</h5><button class="btn-close" data-bs-dismiss="modal"
                                                          aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="text-center mb-3">
            <label for="groupPhotoFile" class="group-photo-picker" title="Escolher foto do grupo">
              <span id="groupPhotoPreview" class="group-photo-preview"><i class="bi bi-camera fs-3"></i></span>
              <input id="groupPhotoFile" type="file" accept="image/*" class="d-none">
            </label>
            <div class="small text-muted mt-2">Escolher foto da galeria</div>
          </div>
          <input id="groupName" class="form-control mb-3" maxlength="120" placeholder="Nome do grupo">
          <textarea id="groupDescription" class="form-control" maxlength="500" rows="3"
                    placeholder="Descrição (opcional)"></textarea>
          <div id="groupCreateError" class="alert alert-danger d-none mt-3 mb-0"></div>
        </div>
        <div class="modal-footer"><button class="btn btn-primary" id="createGroupBtn"><i
          class="bi bi-people me-1"></i>Criar grupo</button></div>
        </div>
      </div>
    </div>
    <script src="~/js/groups/groups.js" asp-append-version="true"></script>
