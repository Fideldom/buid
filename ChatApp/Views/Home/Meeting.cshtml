@{
    ViewData["Title"] = "Reunião";
    Layout = null;
    var roomCode = ViewBag.RoomCode as string ?? "";
}
<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reunião - ChatApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="meeting-page">
    <div class="meeting-header d-flex justify-content-between align-items-center p-2">
        <span>Sala: <strong>@roomCode</strong></span>
        <button id="btnLeaveMeeting" class="btn btn-danger btn-sm"> <a class="page-link" href="Index">Sair da
            reunião</a> </button>
        </div>
        <div id="videoGrid" class="video-grid" data-room="@roomCode"></div>
        <div class="meeting-controls">
            <button id="btnToggleMic" class="btn btn-light rounded-circle"><i class="bi bi-mic-fill"></i></button>
            <button id="btnToggleCam" class="btn btn-light rounded-circle"><i class="bi bi-camera-video-fill"></i></button>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
        <script src="~/js/meeting.js"></script>
    </body>

</html>
