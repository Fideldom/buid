@{ ViewData["Title"] = "Status"; Layout = "_Layout"; }
<div class="status-page container py-4" id="statusApp">
 <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Status</h1><p class="text-muted mb-0">Partilha uma atualização que desaparece após 24 horas.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#statusModal"><i class="bi bi-plus-lg me-1"></i>Novo status</button></div>
 <div id="statusList" class="row g-3"></div>
</div>
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Novo status</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
 <textarea id="statusText" class="form-control mb-3" maxlength="1000" rows="5" placeholder="O que estás a pensar?"></textarea>
 <label class="status-media-picker w-100 mb-2"><input id="statusMediaFile" type="file" accept="image/*,video/*" class="d-none"><span id="statusMediaLabel"><i class="bi bi-images me-2"></i>Escolher foto ou vídeo da galeria</span></label>
 <div id="statusPreview" class="mb-2"></div><div id="statusError" class="alert alert-danger d-none mb-0"></div>
 </div><div class="modal-footer"><button class="btn btn-primary" id="createStatusBtn"><i class="bi bi-send me-1"></i>Publicar</button></div></div></div></div>
<script src="~/js/status/status.js" asp-append-version="true"></script>
